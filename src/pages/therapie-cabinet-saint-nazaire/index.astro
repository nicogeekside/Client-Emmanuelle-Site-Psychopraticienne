---
import MainLayout from '../../layouts/MainLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Button from '../../components/Button.astro';
import FaqSection from '../../components/FaqSection.astro';
import { Image } from 'astro:assets';
import imgHeroCabinet from '../../assets/images/img_modifs/Capture d’écran 2026-06-09 165250.png';
import cabinetImg from '../../assets/images/img_modifs/CABINET.webp';
import immeubleImg from '../../assets/images/img_modifs/IMMEUBLE.webp';
import salleAttenteImg from '../../assets/images/img_modifs/SALLE ATTENTE.webp';
import { siteInfo } from '../../data/config';
---

<MainLayout 
  title="Thérapie en Cabinet à Saint-Nazaire | Emmanuelle Demeulemeester Psychopraticienne"
  description="Rencontrez Emmanuelle Demeulemeester dans son cabinet à Saint-Nazaire. Un espace chaleureux et confidentiel pour vos séances de psychothérapie EMDR et EFT. Parking gratuit."
>
  <Header />
  
  <main>
    <!-- HERO -->
    <section class="relative min-h-[60vh] lg:min-h-[65vh] flex flex-col justify-end overflow-hidden bg-secondary">
      <div class="absolute inset-0 z-0">
        <Image 
          src={imgHeroCabinet}
          alt="Cabinet de psychothérapie Emmanuelle Demeulemeester Saint-Nazaire"
          class="w-full h-full object-cover object-[center_30%] opacity-40"
          width={1400}
          loading="eager"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-primary via-primary/60 to-primary/20"></div>
      </div>

      <div class="container mx-auto px-6 lg:px-8 pb-16 pt-32 relative z-10 text-secondary">
        <nav class="text-sm text-secondary/50 mb-6 flex items-center gap-2" aria-label="Fil d'Ariane">
          <a href="/" class="hover:text-white transition-colors">Accueil</a>
          <span>/</span>
          <span class="text-white">Thérapie en cabinet</span>
        </nav>
        <div class="max-w-3xl">
          <div class="inline-flex items-center gap-2 bg-white/15 backdrop-blur-sm border border-white/20 rounded-full px-4 py-2 mb-6">
            <span class="text-2xl leading-none">🛋️</span>
            <span class="text-sm font-medium text-white">Cabinet · Saint-Nazaire · Parking gratuit</span>
          </div>
          <h1 class="text-4xl md:text-5xl lg:text-6xl font-serif font-bold mb-6 leading-[1.1]">
            Thérapie en cabinet
          </h1>
          <p class="text-xl text-secondary/85 leading-relaxed mb-8 max-w-2xl">
            Venez dans un espace pensé pour vous. Calme, confidentiel et apaisant pour un moment en toute sécurité.
          </p>
          <div class="flex flex-col sm:flex-row gap-4 mb-4">
            <Button href="/prendre-rendez-vous-saint-nazaire/" variant="white" class="text-lg px-8 py-4 shadow-xl">
              Prendre rendez-vous au cabinet
            </Button>
            <a href={`tel:${siteInfo.phone.replace(/\s/g, '')}`} class="inline-flex items-center justify-center gap-2 text-lg px-8 py-4 border-2 border-white/30 rounded-xl text-white hover:bg-white/10 transition-all">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg>
              {siteInfo.phone}
            </a>
          </div>
          <a href="/seance-decouverte-therapie-psychocorporelle-saint-nazaire/" class="inline-flex items-center gap-2 text-sm font-bold bg-white text-primary px-4 py-2 rounded-full shadow-md hover:bg-secondary/50 transition-colors">
            <span class="text-accent">✦</span>
            <span>Séance découverte de 45 min offerte</span>
          </a>
        </div>
      </div>
    </section>

    <!-- LE LIEU -->
    <section class="py-20 bg-background">
      <div class="container mx-auto px-6 lg:px-8 max-w-5xl">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-16 items-center">
          <div data-aos="fade-right">
            <span class="text-accent font-bold tracking-wider uppercase text-sm block mb-3">Le cabinet</span>
            <h2 class="text-3xl font-serif font-bold text-primary mb-6">Un lieu pensé pour votre bien-être</h2>
            <p class="text-lg text-text-main/75 mb-5 leading-relaxed">
              Mon cabinet est situé à Saint-Nazaire, dans un environnement calme et accessible. Dès que vous franchissez la porte, l'objectif est que vous vous sentiez en sécurité et à l'aise.
            </p>
            <p class="text-text-main/70 mb-5 leading-relaxed">
              C'est un espace chaleureux, confidentiel, sans jugement. Vous pouvez y venir seul(e), pour parler librement, sans avoir à vous préparer ou à tout expliquer d'avance.
            </p>
            
            <!-- Infos pratiques -->
            <div class="mt-8 space-y-4">
              {[
                { icon: "📍", label: "Adresse", value: siteInfo.address.full },
                { icon: "🅿️", label: "Stationnement", value: "Parking gratuit à proximité immédiate" },
                { icon: "🕘", label: "Horaires cabinet", value: "Lundi & Mardi : 9h – 20h" },
                { icon: "📞", label: "Téléphone", value: siteInfo.phone, href: `tel:${siteInfo.phone.replace(/\s/g, '')}` },
                { icon: "✉️", label: "Email", value: siteInfo.email, href: `mailto:${siteInfo.email}` },
              ].map(item => (
                <div class="flex gap-4 items-start">
                  <span class="text-xl flex-shrink-0 w-8">{item.icon}</span>
                  <div>
                    <span class="text-xs font-bold uppercase tracking-wider text-text-muted">{item.label}</span>
                    {item.href ? (
                      <a href={item.href} class="block text-primary font-medium hover:text-accent transition-colors">{item.value}</a>
                    ) : (
                      <p class="text-primary font-medium">{item.value}</p>
                    )}
                  </div>
                </div>
              ))}
            </div>
          </div>

          <!-- Photos -->
          <div class="grid grid-cols-2 md:grid-cols-3 gap-4" data-aos="fade-left">
            <div class="aspect-[3/4] rounded-2xl overflow-hidden shadow-lg group col-span-1">
              <Image 
                src={immeubleImg} 
                alt="Immeuble cabinet Emmanuelle Demeulemeester Saint-Nazaire" 
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                width={400}
              />
            </div>
            <div class="aspect-[3/4] rounded-2xl overflow-hidden shadow-lg group col-span-1 mt-8">
              <Image 
                src={salleAttenteImg} 
                alt="Salle d'attente cabinet" 
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                width={400}
              />
            </div>
            <div class="aspect-[3/4] rounded-2xl overflow-hidden shadow-lg group col-span-2 md:col-span-1">
              <Image 
                src={cabinetImg} 
                alt="Cabinet de consultation" 
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                width={400}
              />
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- CE QU'ON PEUT FAIRE EN CABINET -->
    <section class="py-16 bg-secondary/40">
      <div class="container mx-auto px-6 lg:px-8 max-w-4xl">
        <h2 class="text-3xl font-serif font-bold text-primary mb-10 text-center" data-aos="fade-up">Ce qu'on peut faire ensemble en cabinet</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
          {[
            { icon: "🧠", title: "EMDR", text: "Protocole complet avec stimulations bilatérales pour le traitement des traumatismes." },
            { icon: "✋", title: "EFT – Tapping", text: "Séances complètes avec l'apprentissage de la technique pour une utilisation autonome." },
            { icon: "💬", title: "Espace de parole", text: "Simplement parler, être écouté(e) sans jugement." },
            { icon: "😮‍💨", title: "Gestion du stress", text: "Techniques de régulation émotionnelle, sophrologie légère, respiration." },
            { icon: "🌱", title: "Suivi thérapeutique", text: "Accompagnement sur plusieurs mois avec un plan adapté à votre évolution." },
            { icon: "👶", title: "Post-Partum & Périnatalité", text: "Soutien spécialisé pour les bouleversements de la parentalité." },
          ].map((item, i) => (
            <div class="bg-rose-50/40 rounded-xl p-6 border border-rose-100 hover:border-rose-300 hover:shadow-md transition-all duration-300" data-aos="fade-up" data-aos-delay={i * 70}>
              <div class="text-3xl mb-3">{item.icon}</div>
              <h3 class="font-bold text-rose-900 mb-2">{item.title}</h3>
              <p class="text-sm text-text-main/80 leading-relaxed">{item.text}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- TARIFS & HORAIRES CABINET -->
    <section class="py-16 bg-background">
      <div class="container mx-auto px-6 lg:px-8 max-w-3xl text-center">
        <h2 class="text-3xl font-serif font-bold text-primary mb-10" data-aos="fade-up">Tarifs & Disponibilités</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <!-- Tarifs -->
          <div class="bg-white rounded-2xl p-8 shadow-sm border border-secondary" data-aos="fade-right">
            <div class="text-3xl mb-4">💳</div>
            <h3 class="font-bold text-primary text-xl mb-6">Tarifs</h3>
            <div class="space-y-3">
              <div class="flex justify-between items-center py-3 border-b border-secondary">
                <span class="text-text-main/80">Séance (1h)</span>
                <span class="font-bold text-primary text-xl">60 €</span>
              </div>
              <div class="py-3 border-b border-secondary">
                <div class="flex justify-between items-center mb-1">
                  <span class="text-text-main/80">Tarif réduit (1h)</span>
                  <span class="font-bold text-primary text-xl">50 €</span>
                </div>
                <p class="text-xs text-text-muted bg-secondary/40 rounded-lg px-3 py-2">🎓 Réservé aux <strong>étudiants</strong> et <strong>demandeurs d’emploi</strong>. Un justificatif vous sera demandé.</p>
              </div>
              <div class="flex justify-between items-center py-3">
                <span class="text-text-main/80">Séance découverte</span>
                <span class="font-bold text-accent text-xl">✦ Gratuite</span>
              </div>
            </div>
            <p class="text-xs text-text-muted mt-4 border-t border-secondary pt-3">Règlement accepté : virement bancaire, espèces ou chèque.</p>
          </div>
          <!-- Horaires -->
          <div class="bg-white rounded-2xl p-8 shadow-sm border border-secondary" data-aos="fade-left">
            <div class="text-3xl mb-4">🗓️</div>
            <h3 class="font-bold text-primary text-xl mb-6">Disponibilités</h3>
            <div class="space-y-3 text-left">
              <div class="bg-secondary/30 rounded-xl px-4 py-3">
                <p class="font-semibold text-text-main text-sm">Lundi & Mardi</p>
                <p class="text-accent font-bold">9h00 – 20h00</p>
              </div>
            </div>
            <p class="text-xs text-text-muted mt-4 border-t border-secondary pt-3">Annulation souhaitée au moins 48h à l’avance, par respect du créneau réservé.</p>
          </div>
        </div>
        <p class="mt-8 text-sm text-text-muted" data-aos="fade-up">Certaines mutuelles remboursent partiellement les séances — renseignez-vous auprès de la vôtre. Je fournis une facture sur demande.</p>
      </div>
    </section>

    <!-- FAQ -->
    <section class="py-16 bg-secondary/30">
      <div class="container mx-auto px-6 lg:px-8 max-w-3xl">
        <h2 class="text-3xl font-serif font-bold text-primary mb-10 text-center" data-aos="fade-up">Questions fréquentes</h2>
        <FaqSection items={[
          {
            question: "Comment se passe une première séance ?",
            answer: "La première séance est un temps d'échange libre. Je vous pose quelques questions pour comprendre votre situation, vos attentes, et vous expliquer comment on peut travailler ensemble. Il n'y a rien à préparer — venez comme vous êtes."
          },
          {
            question: "Dois-je déjà savoir si je veux faire de l'EMDR ou de l'EFT ?",
            answer: "Non, pas du tout. C'est mon rôle de vous proposer l'approche la plus adaptée à ce que vous traversez. Lors du premier échange, on détermine ensemble ce qui vous correspond le mieux."
          },
          {
            question: "Le cabinet est-il accessible en transport en commun ?",
            answer: "Oui, le cabinet est accessible. Il y a également un parking gratuit à proximité pour les personnes venant en voiture."
          },
          {
            question: "Que faire si je dois annuler mon rendez-vous ?",
            answer: "Merci de me prévenir au moins 48h à l'avance par téléphone ou email. Les annulations de dernière minute peuvent être facturées selon les disponibilités."
          }
        ]} />
      </div>
    </section>

    <!-- CARTE -->
    <section class="py-16 bg-background">
      <div class="container mx-auto px-6 lg:px-8 max-w-4xl">
        <h2 class="text-3xl font-serif font-bold text-primary mb-8 text-center" data-aos="fade-up">Trouver le cabinet</h2>
        <div class="aspect-video rounded-2xl overflow-hidden shadow-xl" data-aos="zoom-in">
          <iframe 
            src="https://www.google.com/maps?q=Emmanuelle+Demeulemeester+Psychothérapeute+7+rue+de+l'étoile+du+matin+44600+Saint-Nazaire&output=embed" 
            width="100%" 
            height="100%" 
            style="border:0;" 
            allowfullscreen="" 
            loading="lazy"
            title="Localisation cabinet Emmanuelle Demeulemeester Saint-Nazaire"
          ></iframe>
        </div>
        <p class="text-center text-text-muted mt-4 text-sm">
          📍 {siteInfo.address.full}
        </p>
      </div>
    </section>

    <!-- CTA -->
    <section class="py-20 bg-primary text-secondary text-center">
      <div class="container mx-auto px-4">
        <h2 class="text-3xl font-serif font-bold mb-4" data-aos="zoom-in">Venez au cabinet</h2>
        <p class="text-lg opacity-80 mb-8 max-w-xl mx-auto">Un premier rendez-vous sans engagement pour découvrir le cabinet et échanger librement.</p>
        <Button href="/prendre-rendez-vous-saint-nazaire/" variant="white" class="text-lg px-10 py-4 shadow-xl">
          Prendre rendez-vous
        </Button>
      </div>
    </section>
  </main>
  
  <Footer />
</MainLayout>
