---
import MainLayout from '../../layouts/MainLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Button from '../../components/Button.astro';
import { Image } from 'astro:assets';
import imgDouceur from '../../assets/images/img-douceur.jpg';
import imgSoutien from '../../assets/images/img-soutien.jpg';
import FaqSection from '../../components/FaqSection.astro';
---

<MainLayout 
  title="Accompagnement Périnatalité & Deuil Saint-Nazaire | Soutien Psy"
  description="Soutien psychologique spécialisé : difficultés maternelles, post-partum, deuil, psycho-oncologie et maladie grave à Saint-Nazaire."
>
  <Header />
  
  <main>
    <!-- Silo Hero -->
    <section class="bg-[#e8e4dc] py-20">
      <div class="container mx-auto px-4 text-center">
        <h1 class="text-3xl md:text-5xl font-serif font-bold mb-6 text-primary" data-aos="fade-up">Accompagnement Périnatalité & Deuil</h1>
        <p class="text-xl max-w-2xl mx-auto text-text-main/80" data-aos="fade-up" data-aos-delay="100">
          Un espace de parole bienveillant pour traverser les grands bouleversements de la vie.
        </p>
      </div>
    </section>

    <!-- Section Périnatalité -->
    <section class="py-16 bg-white">
      <div class="container mx-auto px-4 grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
        <div class="order-2 md:order-1" data-aos="fade-right">
            <h2 class="text-3xl font-serif font-bold text-accent mb-6">Maternité & Parentalité</h2>
            <p class="text-lg text-text-main/80 mb-4">
                Devenir parent est un bouleversement intense. Il arrive que la joie se mêle à l'angoisse, à l'épuisement ou à un sentiment d'isolement.
            </p>
            <ul class="space-y-3 mt-6">
                <li class="flex items-center text-text-main">
                    <span class="w-2 h-2 bg-accent rounded-full mr-3"></span> Difficultés pendant la grossesse
                </li>
                <li class="flex items-center text-text-main">
                    <span class="w-2 h-2 bg-accent rounded-full mr-3"></span> Dépression post-partum, Baby blues
                </li>
                <li class="flex items-center text-text-main">
                    <span class="w-2 h-2 bg-accent rounded-full mr-3"></span> Deuil périnatal (Fausse couche, IVG, IMG)
                </li>
                <li class="flex items-center text-text-main">
                    <span class="w-2 h-2 bg-accent rounded-full mr-3"></span> Burn-out parental
                </li>
            </ul>
        </div>
         <div class="order-1 md:order-2 rounded-xl overflow-hidden shadow-sm aspect-video" data-aos="fade-left">
            <Image 
              src={imgDouceur} 
              alt="Douceur maternelle et accompagnement parentalité" 
              class="w-full h-full object-cover transform hover:scale-105 transition-transform duration-500"
              width={800}
            />
        </div>
      </div>
    </section>


    <!-- Section Deuil & Maladie -->
    <section class="py-16 bg-primary/5">
      <div class="container mx-auto px-4 grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
         <div class="rounded-xl overflow-hidden shadow-sm aspect-video" data-aos="fade-right">
             <Image 
              src={imgSoutien} 
              alt="Soutien psychologique et accompagnement deuil" 
              class="w-full h-full object-cover transform hover:scale-105 transition-transform duration-500"
              width={800}
            />
        </div>
        <div data-aos="fade-left">
            <h2 class="text-3xl font-serif font-bold text-primary mb-6">Deuil & Psycho-oncologie</h2>
            <p class="text-lg text-text-main/80 mb-4">
                La maladie grave (cancer, maladie chronique) et la perte d'un proche sont des épreuves qui nécessitent un soutien spécifique pour ne pas s'effondrer.
            </p>
            <p class="text-lg text-text-main/80 mb-6">
                Je vous offre une écoute active et des outils pour accueillir vos émotions (colère, tristesse, peur) et trouver les ressources pour avancer, à votre rythme.
            </p>
            <div class="bg-white p-4 rounded-lg border border-gray-100 shadow-sm">
                <p class="text-primary font-semibold">Soutien aux aidants</p>
                <p class="text-sm text-text-main/70">J'accompagne également les proches aidants qui s'épuisent souvent à soutenir leur malade.</p>
            </div>
        </div>
      </div>
    </section>

    <!-- FAQ Spécialisée -->
    <section class="py-16 bg-white">
      <div class="container mx-auto px-4 max-w-3xl">
        <h2 class="text-3xl font-serif font-bold text-primary mb-8 text-center">Questions fréquentes</h2>
        <FaqSection items={[
            {
              question: "Pourquoi consulter en période périnatale (grossesse/post-partum) ?",
              answer: "La maternité réveille souvent des fragilités anciennes ou des angoisses. Consulter permet de <strong>prévenir la dépression post-partum</strong>, de déposer sa fatigue sans jugement et de construire un lien serein avec son bébé. Ce n'est pas un aveu de faiblesse, c'est un cadeau pour votre famille."
            },
            {
              question: "Comment surmonter un deuil périnatal ?",
              answer: "Le deuil d'un enfant (in utero ou à la naissance) est un traumatisme souvent invisibilisé par la société. Mon accompagnement vous offre un <strong>espace sacré</strong> pour reconnaître votre douleur, légitimer votre vécu de parent et intégrer doucement cette perte dans votre histoire."
            },
            {
              question: "Accompagnez-vous les conjoints ?",
              answer: "Oui, la souffrance touche aussi les pères et co-parents, qui se sentent souvent impuissants. Ils sont les bienvenus, que ce soit pour une séance en couple ou en individuel."
            }
          ]} />
      </div>
    </section>

    <!-- CTA -->
    <section class="py-16 bg-white text-center">
        <h2 class="text-2xl font-serif font-bold text-primary mb-8">Vous traversez une période difficile ?</h2>
        <p class="mb-8 text-text-main/70">Ne restez pas seul(e) face à votre souffrance.</p>
        <Button href="/prendre-rendez-vous-saint-nazaire/" variant="accent" class="text-lg">
          Me contacter pour en parler
        </Button>
    </section>

  </main>
  
  <Footer />
</MainLayout>
