---
import MainLayout from '../../layouts/MainLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Button from '../../components/Button.astro';
import { siteInfo } from '../../data/config';
---

<MainLayout
  title={`Message bien reçu | ${siteInfo.name}`}
  description="Votre message a bien été transmis à Emmanuelle Demeulemeester. Vous recevrez une réponse sous 48h."
  noindex={true}
>
  <Header />

  <main class="py-24 bg-secondary/10">
    <div class="container mx-auto px-4 max-w-2xl">
      <div class="bg-white p-10 md:p-14 rounded-2xl shadow-sm text-center">

        <div class="w-16 h-16 mx-auto mb-8 rounded-full bg-accent/20 text-accent-dark flex items-center justify-center">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
          </svg>
        </div>

        <h1 class="text-3xl md:text-4xl font-serif font-bold text-primary mb-6">
          Votre message est bien arrivé
        </h1>

        <p class="text-text-main/90 leading-relaxed mb-4">
          Merci de votre confiance. Je prends le temps de lire chaque message
          personnellement et je vous réponds généralement sous 48 heures ouvrées.
        </p>

        <p class="text-text-main/90 leading-relaxed mb-10">
          Si votre demande est urgente, vous pouvez me joindre directement au
          <a href={`tel:${siteInfo.phone.replace(/\s/g, '')}`} class="text-accent-dark hover:underline font-semibold whitespace-nowrap">{siteInfo.phone}</a>.
        </p>

        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <Button href="/" variant="primary">Retour à l'accueil</Button>
          <Button href="/prendre-rendez-vous-saint-nazaire/#rdv-en-ligne" variant="outline">
            Réserver un créneau
          </Button>
        </div>

      </div>
    </div>
  </main>

  <Footer />
</MainLayout>
