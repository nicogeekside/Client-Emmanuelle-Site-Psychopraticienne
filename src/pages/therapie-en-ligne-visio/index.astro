---
import MainLayout from '../../layouts/MainLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Button from '../../components/Button.astro';
import FaqSection from '../../components/FaqSection.astro';
import { siteInfo } from '../../data/config';
---

<MainLayout 
  title="Thérapie en Visio | Psychopraticienne en ligne - Emmanuelle Demeulemeester"
  description="Séances de psychothérapie en visio avec Emmanuelle Demeulemeester, psychopraticienne certifiée. EMDR et EFT en ligne, partout en France. Confidentiel, efficace et flexible."
>
  <Header />
  
  <main>
    <!-- HERO -->
    <section class="relative min-h-[60vh] bg-primary flex flex-col justify-end overflow-hidden">
      <div class="absolute inset-0 pointer-events-none">
        <div class="absolute top-1/4 left-1/4 w-64 h-64 bg-white/5 rounded-full blur-3xl"></div>
        <div class="absolute bottom-1/3 right-1/4 w-80 h-80 bg-primary-light/10 rounded-full blur-3xl"></div>
        <div class="absolute inset-0 opacity-5" style="background-image: radial-gradient(circle, white 1px, transparent 1px); background-size: 40px 40px;"></div>
      </div>

      <div class="container mx-auto px-6 lg:px-8 pb-16 pt-32 relative z-10 text-secondary">
        <nav class="text-sm text-secondary/50 mb-6 flex items-center gap-2" aria-label="Fil d'Ariane">
          <a href="/" class="hover:text-white transition-colors">Accueil</a>
          <span>/</span>
          <span class="text-white">Thérapie en visio</span>
        </nav>
        <div class="max-w-3xl">
          <div class="inline-flex items-center gap-2 bg-white/15 backdrop-blur-sm border border-white/20 rounded-full px-4 py-2 mb-6">
            <span class="text-2xl leading-none">💻</span>
            <span class="text-sm font-medium text-white">Partout en France · Disponible dès maintenant</span>
          </div>
          <h1 class="text-4xl md:text-5xl lg:text-6xl font-serif font-bold mb-6 leading-[1.1]">
            Thérapie en visio
          </h1>
          <p class="text-xl text-secondary/85 leading-relaxed mb-8 max-w-2xl">
            Le même accompagnement bienveillant, depuis chez vous. Partout en France, à votre rythme.
          </p>
          <div class="flex flex-col sm:flex-row gap-4 mb-4">
            <Button href="/prendre-rendez-vous-saint-nazaire/" variant="white" class="text-lg px-8 py-4 shadow-xl">
              Prendre rendez-vous en visio
            </Button>
            <a href={`tel:${siteInfo.phone.replace(/\s/g, '')}`} class="inline-flex items-center justify-center gap-2 text-lg px-8 py-4 border-2 border-white/30 rounded-xl text-white hover:bg-white/10 transition-all">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg>
              {siteInfo.phone}
            </a>
          </div>
          <a href="/seance-decouverte-therapie-psychocorporelle-saint-nazaire/" class="inline-flex items-center gap-2 text-sm font-bold bg-white text-primary px-4 py-2 rounded-full shadow-md hover:bg-secondary/50 transition-colors">
            <span class="text-accent">✦</span>
            <span>Séance découverte de 45 min offerte</span>
          </a>
        </div>
      </div>
    </section>

    <!-- AVANTAGES -->
    <section class="py-20 bg-background">
      <div class="container mx-auto px-6 lg:px-8 max-w-5xl">
        <div class="text-center mb-14" data-aos="fade-up">
          <span class="text-accent font-bold tracking-wider uppercase text-sm block mb-3">Pourquoi choisir la visio ?</span>
          <h2 class="text-3xl md:text-4xl font-serif font-bold text-primary mb-4">La thérapie s'adapte à votre vie</h2>
          <p class="text-text-main/65 max-w-2xl mx-auto">
            Vous n'avez pas à vous déplacer à Saint-Nazaire pour bénéficier d'un accompagnement de qualité.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {[
            { icon: "🏠", title: "Depuis chez vous", text: "Pas de transport, pas de déplacement. Vous restez dans votre espace familier, ce qui peut faciliter la détente et l'ouverture." },
            { icon: "🇫🇷", title: "Partout en France", text: "Vous habitez loin de Saint-Nazaire ? Ce n'est pas un obstacle. La thérapie en visio vous donne accès à mon accompagnement où que vous soyez." },
            { icon: "📅", title: "Plus de flexibilité", text: "Les créneaux visio s'adaptent plus facilement à vos contraintes professionnelles ou familiales." },
            { icon: "🔒", title: "Totalement confidentiel", text: "Les séances se déroulent via une plateforme sécurisée. Votre vie privée est protégée à chaque échange." },
            { icon: "✅", title: "Aussi efficace", text: "Les études montrent que la thérapie en visio est aussi efficace que la thérapie en présentiel pour la majorité des problématiques." },
            { icon: "💛", title: "EMDR et EFT en visio", text: "Les deux protocoles sont parfaitement réalisables à distance. Je vous guide étape par étape, comme si vous étiez en face de moi." },
          ].map((item, i) => (
            <div class="p-7 rounded-2xl border border-blue-100 bg-blue-50/40 hover:border-blue-300 hover:bg-blue-100/30 hover:shadow-md transition-all duration-300 group" data-aos="fade-up" data-aos-delay={i * 70}>
              <div class="text-3xl mb-4 group-hover:scale-110 transition-transform">{item.icon}</div>
              <h3 class="font-bold text-blue-900 mb-2">{item.title}</h3>
              <p class="text-sm text-text-main/80 leading-relaxed">{item.text}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- COMMENT ÇA MARCHE -->
    <section class="py-20 bg-secondary/40">
      <div class="container mx-auto px-6 lg:px-8 max-w-4xl">
        <h2 class="text-3xl font-serif font-bold text-primary mb-12 text-center" data-aos="fade-up">Comment se passe une séance en visio ?</h2>
        <div class="space-y-6">
          {[
            { step: "01", title: "Vous réservez un créneau", text: "Via le formulaire de contact ou par téléphone. Je vous envoie ensuite le lien de connexion sécurisé." },
            { step: "02", title: "Vous vous installez confortablement", text: "Dans une pièce calme où vous ne serez pas dérangé(e). Un casque ou des écouteurs améliorent la qualité de l'échange." },
            { step: "03", title: "On se connecte", text: "Je vous retrouve à l'heure exacte sur la plateforme sécurisée. Pas d'application à installer, juste un lien à cliquer." },
            { step: "04", title: "La séance se déroule normalement", text: "EMDR, EFT ou espace de parole — je m'adapte à ce dont vous avez besoin et je vous guide comme en présentiel." },
          ].map((item, i) => (
            <div class="flex gap-6 items-start" data-aos="fade-up" data-aos-delay={i * 100}>
              <div class="flex-shrink-0 w-14 h-14 rounded-2xl bg-primary flex items-center justify-center shadow-lg">
                <span class="text-white font-bold text-xl font-serif">{item.step}</span>
              </div>
              <div class="pt-2">
                <h3 class="font-bold text-primary text-lg mb-1">{item.title}</h3>
                <p class="text-text-main/70 leading-relaxed">{item.text}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="py-16 bg-background">
      <div class="container mx-auto px-6 lg:px-8 max-w-3xl">
        <h2 class="text-3xl font-serif font-bold text-primary mb-10 text-center" data-aos="fade-up">Questions fréquentes</h2>
        <FaqSection items={[
          {
            question: "Quelle plateforme utilisez-vous pour les séances en visio ?",
            answer: "J'utilise une plateforme vidéo sécurisée et confidentielle. Pas besoin de créer un compte ou d'installer une application — il suffit de cliquer sur le lien que je vous envoie."
          },
          {
            question: "L'EMDR est-elle vraiment possible à distance ?",
            answer: "Oui, tout à fait. En visio, on adapte le protocole EMDR avec des stimulations bilatérales visuelles (via l'écran) ou des auto-stimulations tactiles que je vous enseigne. Les résultats sont comparables à une séance en présentiel."
          },
          {
            question: "Est-ce que c'est remboursé par la Sécurité Sociale ?",
            answer: "Les séances de psychopratique ne sont pas remboursées par la Sécurité Sociale, ni en cabinet ni en visio. Certaines mutuelles prennent en charge une partie des frais. Je vous fournis une facture pour votre mutuelle sur demande."
          },
          {
            question: "Que faire si ma connexion internet est instable ?",
            answer: "On s'adapte ! En cas de coupure, on peut basculer en appel téléphonique. Je prends toujours le temps de vérifier avec vous au début de chaque séance que la connexion est bonne."
          }
        ]} />
      </div>
    </section>

    <!-- CTA -->
    <section class="py-20 bg-primary text-secondary text-center">
      <div class="container mx-auto px-4">
        <h2 class="text-3xl font-serif font-bold mb-4" data-aos="zoom-in">Prêt(e) pour une première séance en visio ?</h2>
        <p class="text-lg opacity-80 mb-8 max-w-xl mx-auto">Prenez rendez-vous — je vous contacte pour confirmer le créneau et vous envoyer le lien de connexion.</p>
        <Button href="/prendre-rendez-vous-saint-nazaire/" variant="white" class="text-lg px-10 py-4 shadow-xl active:scale-95 transition-all">
          Réserver mon créneau
        </Button>
      </div>
    </section>
  </main>
  
  <Footer />
</MainLayout>
