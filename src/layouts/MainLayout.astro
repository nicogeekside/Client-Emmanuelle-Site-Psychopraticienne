---
import { SEO } from 'astro-seo';
import '../styles/global.css';
import 'aos/dist/aos.css';
import '@fontsource/playfair-display';
import '@fontsource/lato';
import { siteInfo, horaires } from '../data/config';

interface Props {
	title: string;
	description?: string;
	image?: string;
	type?: string;
	noindex?: boolean;
}

const { 
	title, 
	description = "Psychopraticienne à Saint-Nazaire - Emmanuelle Demeulemeester vous accompagne en cabinet, en visio ou en marchant. EMDR, EFT, soutien Post-Partum en Loire-Atlantique.",
	image = "/social-image.jpg",
	type = "website",
	noindex = false
} = Astro.props;

// Le domaine vient d'astro.config.mjs (Astro.site) : une seule source de verite,
// sinon la canonical, le sitemap et og:url finissent par diverger.
const canonicalURL = new URL(Astro.url.pathname, Astro.site).href;
// Les réseaux sociaux exigent une URL absolue : un chemin relatif n'est pas résolu
// par les robots de Facebook, WhatsApp ou LinkedIn.
const imageURL = new URL(image, Astro.site).href;

// Schema.org JSON-LD pour le SEO local (GEO)
const schemaOrg = {
	"@context": "https://schema.org",
	"@type": ["LocalBusiness", "HealthAndBeautyBusiness"],
	"name": siteInfo.name,
	"description": description,
	"url": canonicalURL,
	"telephone": siteInfo.phone,
	"email": siteInfo.email,
	"image": imageURL,
	"address": {
		"@type": "PostalAddress",
		"streetAddress": siteInfo.address.street,
		"addressLocality": siteInfo.address.city,
		"postalCode": siteInfo.address.zip,
		"addressRegion": siteInfo.address.region,
		"addressCountry": siteInfo.address.country
	},
	"geo": {
		"@type": "GeoCoordinates",
		"latitude": siteInfo.geo.latitude,
		"longitude": siteInfo.geo.longitude
	},
	"areaServed": [
		{ "@type": "City", "name": "Saint-Nazaire" },
		{ "@type": "City", "name": "Pornichet" },
		{ "@type": "City", "name": "La Baule-Escoublac" },
		{ "@type": "City", "name": "Trignac" },
		{ "@type": "City", "name": "Montoir-de-Bretagne" },
		{ "@type": "City", "name": "Saint-Brevin-les-Pins" }
	],
	// Générés depuis config.js. Les horaires affichés sur les pages sont encore
	// écrits en dur : leur branchement sur cette même source est prévu au lot 5.
	"openingHoursSpecification": horaires.map((h) => ({
		"@type": "OpeningHoursSpecification",
		"dayOfWeek": h.schema.jours,
		"opens": h.schema.ouvre,
		"closes": h.schema.ferme
	})),
	"priceRange": "€€",
	"knowsAbout": ["EMDR", "EFT", "Thérapie en marchant", "Soutien post-partum", "Gestion du stress", "Traumatismes", "Anxiété"],
	"hasCredential": [
		{
			"@type": "EducationalOccupationalCredential",
			"name": "Psycho-Praticienne en Techniques Énergétiques et Psycho-Corporelles — option EFT Clinique (360 h)",
			"credentialCategory": "certificate",
			"recognizedBy": { "@type": "Organization", "name": "IFPEC — Institut Francophone de Psychologie Énergétique Clinique" }
		},
		{
			"@type": "EducationalOccupationalCredential",
			"name": "Praticienne en EMDR-DSA — Niveau 2",
			"credentialCategory": "certificate",
			"recognizedBy": { "@type": "Organization", "name": "AHTMA Formation" }
		}
	],
	"sameAs": []
};
---

<!doctype html>
<html lang="fr" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<meta name="generator" content={Astro.generator} />

		<!-- Google Search Console -->
		<meta name="google-site-verification" content="R3HWIHQskIXynk-I5_ZeTf9q3L3-iiA7SDyRCc5W_mU" />

		<!-- Geo meta pour référencement local -->
		<meta name="geo.region" content="FR-44" />
		<meta name="geo.placename" content="Saint-Nazaire" />
		<meta name="geo.position" content={`${siteInfo.geo.latitude};${siteInfo.geo.longitude}`} />
		<meta name="ICBM" content={`${siteInfo.geo.latitude}, ${siteInfo.geo.longitude}`} />

		<!-- SEO -->
		<SEO
			title={title}
			noindex={noindex}
			description={description}
			openGraph={{
				basic: {
					title: title,
					type: type,
					image: imageURL,
					url: canonicalURL.toString(),
				},
				optional: {
					description: description,
					locale: "fr_FR",
					siteName: siteInfo.name,
				}
			}}
			twitter={{
				card: "summary_large_image",
				title: title,
				description: description,
				image: imageURL,
			}}
			extend={{
				meta: [
					{ name: "author", content: siteInfo.name },
					{ property: "og:image:width", content: "1200" },
					{ property: "og:image:height", content: "630" },
					{ property: "og:image:alt", content: `${siteInfo.name}, psychopraticienne à Saint-Nazaire` },
					{ name: "theme-color", content: "#3D5A4E" },
				]
			}}
		/>

		<!-- Schema.org JSON-LD -->
		<script type="application/ld+json" set:html={JSON.stringify(schemaOrg)} />

		<!-- Script Netlify Identity (Nécessaire pour le setup initial du mot de passe admin) -->
		<script is:inline src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>

	</head>
	<body class="font-sans text-text-main antialiased bg-secondary">
		<slot />
		
		<script>
			import AOS from 'aos';
			AOS.init({
				duration: 800,
				easing: 'ease-out-cubic',
				once: true,
				offset: 50,
			});
		</script>
		<script is:inline>
			if (window.netlifyIdentity) {
			  window.netlifyIdentity.on("init", user => {
				if (!user) {
				  window.netlifyIdentity.on("login", () => {
					document.location.href = "/admin/";
				  });
				}
			  });
			}
		</script>
	</body>
</html>
