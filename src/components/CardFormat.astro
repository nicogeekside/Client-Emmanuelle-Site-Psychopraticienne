---
interface Props {
  id: string;
  icon: string;
  title: string;
  subtitle: string;
  description: string;
  note: string;
  href: string;
  color?: string;
  accent?: string;
  border?: string;
  index?: number;
}

const { id, icon, title, subtitle, description, note, href, color = "from-gray-50 to-gray-100", accent = "text-primary", border = "border-gray-200", index = 0 } = Astro.props;
---

<a 
  href={href} 
  class="group block h-full"
  data-aos="fade-up"
  data-aos-delay={index * 80}
  aria-label={`Découvrir : ${title}`}
>
  <div class={`h-full rounded-2xl border-2 ${border} bg-gradient-to-br ${color} p-8 flex flex-col gap-5 relative overflow-hidden transition-all duration-500 hover:shadow-2xl hover:-translate-y-2 hover:border-opacity-60 cursor-pointer`}>
    
    <!-- Blob décoratif -->
    <div class="absolute -top-12 -right-12 w-40 h-40 rounded-full bg-white/30 blur-2xl group-hover:scale-150 transition-transform duration-700 pointer-events-none"></div>
    <div class="absolute -bottom-8 -left-8 w-28 h-28 rounded-full bg-white/20 blur-xl group-hover:scale-125 transition-transform duration-700 pointer-events-none"></div>

    <!-- Icône + badge -->
    <div class="flex items-start justify-between relative z-10">
      <div class="text-5xl group-hover:scale-110 transition-transform duration-300 select-none leading-none">{icon}</div>
      <div class="flex items-center gap-1.5 bg-white/70 backdrop-blur-sm border border-white/80 rounded-full px-3 py-1.5 shadow-sm">
        <span class="w-2 h-2 rounded-full bg-current animate-pulse" class:list={[accent]}></span>
        <span class={`text-xs font-bold tracking-wide uppercase ${accent}`}>{subtitle}</span>
      </div>
    </div>

    <!-- Texte -->
    <div class="flex-grow relative z-10">
      <h3 class="text-2xl font-serif font-bold text-primary mb-3 leading-tight group-hover:text-primary/90 transition-colors">
        {title}
      </h3>
      <p class="text-text-main/75 leading-relaxed">
        {description}
      </p>
    </div>

    <!-- Note + flèche -->
    <div class="flex items-center justify-between relative z-10 pt-4 border-t border-white/60">
      <span class="text-sm text-text-main/60 italic">{note}</span>
      <div class={`w-9 h-9 rounded-full bg-white shadow-md flex items-center justify-center group-hover:shadow-lg group-hover:scale-110 transition-all duration-300`}>
        <svg xmlns="http://www.w3.org/2000/svg" class={`h-4 w-4 ${accent} group-hover:translate-x-0.5 transition-transform`} fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </div>
    </div>
  </div>
</a>
