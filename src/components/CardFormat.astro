---
interface Props {
  id: string;
  icon: string;
  title: string;
  subtitle: string;
  description: string;
  note: string;
  href: string;
  color?: string;
  accent?: string;
  border?: string;
  index?: number;
}

const { id, icon, title, subtitle, description, note, href, color = "from-white to-secondary/30", accent = "text-primary-dark", border = "border-secondary", index = 0 } = Astro.props;

import Icon from './Icon.astro';
---

<a
  href={href}
  class="group block h-full rounded-2xl focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary-dark focus-visible:ring-offset-2 focus-visible:ring-offset-background"
  data-aos="fade-up"
  data-aos-delay={index * 80}
  aria-label={`${title} — découvrir ce format`}
>
  <div class={`h-full rounded-2xl border ${border} bg-gradient-to-br ${color} p-8 flex flex-col gap-5 transition-[transform,box-shadow] duration-500 ease-out group-hover:-translate-y-1 group-hover:shadow-xl`}>

    <Icon name={icon} size={44} stroke={1.25} class={`shrink-0 ${accent} transition-transform duration-500 ease-out group-hover:-translate-y-0.5`} />

    <div class="flex-grow">
      <!-- « Thérapie en marchant » passe sur deux lignes quand les trois autres
           tiennent sur une : sans hauteur commune, les sous-titres de la rangée
           se décalent. Reserve deux lignes seulement là où les cartes sont
           cote a cote. -->
      <h3 class="text-2xl font-serif font-bold text-primary leading-tight lg:min-h-[3.75rem]">
        {title}
      </h3>
      <p class={`mt-1.5 mb-3 text-xs font-bold uppercase tracking-[0.12em] ${accent}`}>
        {subtitle}
      </p>
      <p class="text-text-main/90 leading-relaxed">
        {description}
      </p>
    </div>

    <div>
      <p class="text-sm text-text-main/75 italic">{note}</p>
      <div class="mt-4 pt-4 border-t border-text-main/10 flex items-center justify-between">
        <!-- L'action est nommée : c'est elle qui dit que la carte se clique,
             pas une flèche décorative dans un rond gris. -->
        <span class={`text-sm font-semibold ${accent} underline-offset-4 decoration-1 group-hover:underline`}>
          Découvrir ce format
        </span>
        <Icon name="arrow-right" size={16} class={`shrink-0 ${accent} transition-transform duration-300 ease-out group-hover:translate-x-1`} />
      </div>
    </div>
  </div>
</a>
