---
import { navItems, navDropdown, navDropdownFormats, siteInfo } from '../data/config';
import Button from './Button.astro';
import { Image } from 'astro:assets';
import logoEmma from '../assets/images/img_modifs/logo_emma_couleurs_fond_transparent (3).png';
---

<header class="fixed w-full top-0 z-50 transition-all duration-300" id="main-header">
  <!-- Background -->
  <div class="absolute inset-0 bg-secondary/97 backdrop-blur-sm shadow-sm z-0 pointer-events-none border-b border-primary/5"></div>
  
  <div class="container mx-auto px-4 py-3 flex justify-between items-center relative z-10">
    <!-- Logo -->
    <a href="/" class="flex items-center gap-3 leading-tight group" aria-label="Accueil - Emmanuelle Demeulemeester, Psychopraticienne">
      <Image src={logoEmma} alt="Logo Emmanuelle Demeulemeester" width={48} class="h-12 w-auto object-contain flex-shrink-0" />
      <div class="flex flex-col">
        <span class="text-xl font-serif font-bold text-primary group-hover:text-accent transition-colors" style="text-shadow: 0 0 15px rgba(255, 255, 255, 1), 0 0 5px rgba(255, 255, 255, 0.8);">Emmanuelle Demeulemeester</span>
        <span class="text-xs font-medium text-text-main/80 tracking-widest uppercase">Psychopraticienne · Saint-Nazaire</span>
      </div>
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden lg:flex items-center gap-1" aria-label="Navigation principale">
      {navItems.map(item => (
        <a 
          href={item.href} 
          class="text-sm text-text-main hover:text-accent font-medium transition-colors relative group whitespace-nowrap px-3 py-2 rounded-lg hover:bg-primary/5"
        >
          {item.name}
          <span class="absolute bottom-1 left-3 right-3 h-0.5 bg-accent scale-x-0 group-hover:scale-x-100 transition-transform duration-300 origin-left rounded-full"></span>
        </a>
      ))}

      <!-- Dropdown Formats -->
      <div class="relative group/dropdown-format">
        <button 
          class="text-sm text-text-main hover:text-accent font-medium transition-colors px-3 py-2 rounded-lg hover:bg-primary/5 flex items-center gap-1 whitespace-nowrap"
          aria-haspopup="true"
          aria-expanded="false"
        >
          {navDropdownFormats.label}
          <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 transition-transform group-hover/dropdown-format:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
          </svg>
        </button>
        <!-- Dropdown menu Formats -->
        <div class="absolute top-full left-0 mt-2 w-52 bg-white rounded-xl shadow-xl border border-gray-100 py-2 opacity-0 invisible group-hover/dropdown-format:opacity-100 group-hover/dropdown-format:visible transition-all duration-200 -translate-y-2 group-hover/dropdown-format:translate-y-0">
          {navDropdownFormats.items.map(item => (
            <a 
              href={item.href} 
              class="flex items-center gap-3 px-4 py-2.5 text-sm text-text-main hover:text-accent hover:bg-secondary/50 transition-colors"
            >
              <span class="w-1.5 h-1.5 rounded-full bg-accent/60"></span>
              {item.name}
            </a>
          ))}
        </div>
      </div>

      <!-- Dropdown Approches -->
      <div class="relative group/dropdown">
        <button 
          class="text-sm text-text-main hover:text-accent font-medium transition-colors px-3 py-2 rounded-lg hover:bg-primary/5 flex items-center gap-1 whitespace-nowrap"
          aria-haspopup="true"
          aria-expanded="false"
        >
          {navDropdown.label}
          <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 transition-transform group-hover/dropdown:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
          </svg>
        </button>
        <!-- Dropdown menu -->
        <div class="absolute top-full right-0 mt-2 w-52 bg-white rounded-xl shadow-xl border border-gray-100 py-2 opacity-0 invisible group-hover/dropdown:opacity-100 group-hover/dropdown:visible transition-all duration-200 -translate-y-2 group-hover/dropdown:translate-y-0">
          {navDropdown.items.map(item => (
            <a 
              href={item.href} 
              class="flex items-center gap-3 px-4 py-2.5 text-sm text-text-main hover:text-accent hover:bg-secondary/50 transition-colors"
            >
              <span class="w-1.5 h-1.5 rounded-full bg-accent/60"></span>
              {item.name}
            </a>
          ))}
        </div>
      </div>

      <div class="w-px h-5 bg-primary/20 mx-2"></div>

      <a href="/seance-decouverte-therapie-psychocorporelle-saint-nazaire/" class="text-sm font-bold text-accent hover:text-accent/80 transition-colors flex items-center gap-1 px-3 py-2">
        <span class="text-lg">✦</span> Séance découverte
      </a>

      <Button href="/prendre-rendez-vous-saint-nazaire/" variant="accent" class="shadow-md hover:shadow-lg transition-shadow text-sm">
        Prendre RDV
      </Button>
    </nav>

    <!-- Mobile Menu Button -->
    <button id="mobile-menu-btn" class="lg:hidden text-primary focus:outline-none p-2" aria-label="Ouvrir le menu">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </div>

  <!-- Mobile Menu Overlay -->
  <div id="mobile-menu" class="hidden fixed inset-0 z-[200] bg-white flex-col lg:hidden">
    <!-- Header Mobile -->
    <div class="flex justify-between items-center px-6 py-4 border-b border-gray-100">
      <span class="text-lg font-serif font-bold text-primary">Emmanuelle Demeulemeester</span>
      <button id="close-menu-btn" class="p-2 text-primary hover:bg-gray-100 rounded-full transition-colors" aria-label="Fermer le menu">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!-- Menu Links Mobile -->
    <div class="flex flex-col overflow-y-auto flex-1 px-6 py-6 gap-2">
      <p class="text-xs font-bold tracking-widest uppercase text-text-main/40 mb-2">Navigation</p>
      {navItems.map(item => (
        <a 
          href={item.href} 
          class="mobile-link text-xl font-serif font-bold text-primary hover:text-accent transition-colors py-3 border-b border-gray-50 flex items-center justify-between group"
        >
          {item.name}
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-accent opacity-0 group-hover:opacity-100 transition-opacity" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      ))}

      <a 
        href="/seance-decouverte-therapie-psychocorporelle-saint-nazaire/" 
        class="mobile-link text-xl font-serif font-bold text-accent hover:text-accent/80 transition-colors py-3 border-b border-gray-50 flex items-center justify-between group"
      >
        <span class="flex items-center gap-2"><span class="text-xl">✦</span> Séance découverte</span>
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 opacity-0 group-hover:opacity-100 transition-opacity" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </a>

      <p class="text-xs font-bold tracking-widest uppercase text-text-main/40 mt-4 mb-2">{navDropdownFormats.label}</p>
      {navDropdownFormats.items.map(item => (
        <a 
          href={item.href} 
          class="mobile-link text-lg text-primary/70 hover:text-accent transition-colors py-2.5 border-b border-gray-50 flex items-center gap-3"
        >
          <span class="w-1.5 h-1.5 rounded-full bg-accent flex-shrink-0"></span>
          {item.name}
        </a>
      ))}

      <p class="text-xs font-bold tracking-widest uppercase text-text-main/40 mt-4 mb-2">{navDropdown.label}</p>
      {navDropdown.items.map(item => (
        <a 
          href={item.href} 
          class="mobile-link text-lg text-primary/70 hover:text-accent transition-colors py-2.5 border-b border-gray-50 flex items-center gap-3"
        >
          <span class="w-1.5 h-1.5 rounded-full bg-accent flex-shrink-0"></span>
          {item.name}
        </a>
      ))}

      <div class="mt-6">
        <Button href="/prendre-rendez-vous-saint-nazaire/" variant="accent" class="mobile-link w-full text-lg py-4 shadow-lg justify-center flex">
          Prendre rendez-vous
        </Button>
        <a href={`tel:${siteInfo.phone.replace(/\s/g, '')}`} class="mobile-link mt-3 flex items-center justify-center gap-2 text-primary/60 hover:text-accent transition-colors py-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
          {siteInfo.phone}
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  const mobileMenuBtn = document.getElementById('mobile-menu-btn');
  const closeMenuBtn = document.getElementById('close-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const mobileLinks = document.querySelectorAll('.mobile-link');
  const body = document.body;

  function openMenu() {
    mobileMenu?.classList.remove('hidden');
    mobileMenu?.classList.add('flex', 'flex-col');
    body.style.overflow = 'hidden';
  }

  function closeMenu() {
    mobileMenu?.classList.add('hidden');
    mobileMenu?.classList.remove('flex', 'flex-col');
    body.style.overflow = '';
  }

  mobileMenuBtn?.addEventListener('click', openMenu);
  closeMenuBtn?.addEventListener('click', closeMenu);
  
  mobileLinks.forEach(link => {
    link.addEventListener('click', closeMenu);
  });
</script>
