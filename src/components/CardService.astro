---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  title: string;
  description: string;
  href: string;
  image?: ImageMetadata | string;
}

const { title, description, href, image } = Astro.props;
---

<div class="group relative" data-aos="fade-up">
  
  {/* Blobs d'arrière plan décoratifs */}
  <div class="absolute -inset-4 bg-gradient-to-r from-accent/20 to-primary/10 rounded-[40%_60%_70%_30%/40%_50%_60%_50%] blur-xl opacity-0 group-hover:opacity-100 transition-opacity duration-700 pointer-events-none"></div>

  <div class="bg-white rounded-2xl shadow-lg border border-secondary/50 overflow-hidden relative z-10 h-full flex flex-col transition-transform duration-300 hover:-translate-y-1">
    
    {/* Badge Séance Découverte */}
    <div class="absolute top-4 right-4 z-30 bg-white/95 backdrop-blur-sm px-4 py-2 rounded-full shadow-md border border-accent/20 flex items-center gap-2 transform group-hover:scale-105 transition-transform">
      <span class="w-2 h-2 rounded-full bg-accent animate-pulse"></span>
      <span class="text-xs font-bold text-primary tracking-wide uppercase">Séance découverte 45 min offerte</span>
    </div>

    {image && (
      <div class="h-64 relative overflow-hidden">
        {/* Masque de forme organique pour l'image */}
        <div class="absolute inset-0 clip-path-curve z-10 pointer-events-none"></div>
        
        <div class="absolute inset-0 bg-gradient-to-t from-primary/80 via-primary/20 to-transparent z-20 group-hover:from-primary/90 transition-colors duration-500"></div>
        
        {typeof image === 'string' ? (
          <img src={image} alt={title} class="w-full h-full object-cover transform group-hover:scale-110 transition-transform duration-700" />
        ) : (
          <Image 
            src={image} 
            alt={title} 
            class="w-full h-full object-cover transform group-hover:scale-110 transition-transform duration-700"
            width={600}
          />
        )}
        
        {/* Titre centré sur l'image */}
        <div class="absolute bottom-0 left-0 w-full p-6 z-30 text-center transform translate-y-2 group-hover:translate-y-0 transition-transform duration-300">
           <h3 class="text-3xl font-serif font-bold text-white drop-shadow-lg mb-1">{title}</h3>
           <div class="w-12 h-1 bg-accent mx-auto rounded-full w-0 group-hover:w-12 transition-all duration-500 delay-100"></div>
        </div>
      </div>
    )}

    <div class="p-8 flex-grow flex flex-col justify-between bg-white relative">
       {/* Petit accent décoratif */}
       <div class="absolute top-0 right-10 w-20 h-20 bg-secondary/30 rounded-full blur-2xl -translate-y-1/2"></div>
       
      <p class="text-text-main/80 mb-8 leading-relaxed text-center relative z-10">
        {description}
      </p>
      
      <div class="text-center">
        <a href={href} class="inline-flex items-center justify-center px-6 py-3 border-2 border-primary/10 rounded-full text-primary font-semibold hover:bg-primary hover:text-white hover:border-primary transition-all duration-300 group-hover:shadow-md">
          En savoir plus
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
      </div>
    </div>
  </div>
</div>

<style>
  /* Optionnel si on veut une forme de vague en bas de l'image via clip-path, 
     sinon le design actuel utilise une superposition dégradée simple qui marche bien */
</style>
