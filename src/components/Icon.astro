---
import fs from 'node:fs';
import path from 'node:path';

interface Props {
  /** Nom du glyphe Lucide, ex. « footprints », « map-pin ». */
  name: string;
  /** Côté du carré de dessin, en pixels. */
  size?: number;
  /** Épaisseur du trait. 1.5 est la valeur de la maison — Lucide livre 2,
      trop lourd à côté du Playfair et du Lato du site. */
  stroke?: number;
  class?: string;
  /** Renseigner uniquement si l'icône porte une information que le texte
      voisin ne dit pas. Sans label, elle est décorative et masquée aux
      lecteurs d'écran. */
  label?: string;
}

const { name, size = 24, stroke = 1.5, class: className, label } = Astro.props;

// Les noms Lucide sont en minuscules séparées par des tirets. Valider ici
// évite qu'un nom calculé puisse sortir du dossier des icônes.
if (!/^[a-z0-9]+(?:-[a-z0-9]+)*$/.test(name ?? '')) {
  throw new Error(`Nom d'icône invalide : « ${name} ». Attendu : minuscules et tirets.`);
}

const fichier = path.join(process.cwd(), 'node_modules', 'lucide-static', 'icons', `${name}.svg`);

if (!fs.existsSync(fichier)) {
  throw new Error(`Icône « ${name} » introuvable dans lucide-static. Vérifiez le nom du glyphe.`);
}

// Mémoïsation : le même glyphe est lu une seule fois par build, pas une fois
// par occurrence — la coche revient 13 fois sur une seule page.
const cache = ((globalThis as any).__iconesLucide ??= new Map<string, string>());

const geometrie = cache.get(name) ?? fs
  .readFileSync(fichier, 'utf8')
  .replace(/<!--[\s\S]*?-->/g, '')
  .replace(/^[\s\S]*?<svg[^>]*>/, '')
  .replace(/<\/svg>\s*$/, '')
  .trim();

cache.set(name, geometrie);
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={stroke}
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
  set:html={geometrie}
/>
