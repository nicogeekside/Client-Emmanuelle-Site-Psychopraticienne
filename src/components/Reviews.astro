---
import { reviews } from '../data/config';
---

<section class="py-12 bg-secondary/30 rounded-2xl">
  <div class="container mx-auto px-4">
    <h2 class="text-3xl font-serif font-bold text-center text-primary mb-12" data-aos="fade-up">Ce qu'ils disent de l'accompagnement</h2>
    
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {reviews.map((review, index) => (
        <div class="bg-white p-8 rounded-xl shadow-sm hover:shadow-md transition-shadow" data-aos="fade-up" data-aos-delay={index * 100}>
          <div class="flex text-accent mb-4">
            {[...Array(review.stars)].map(() => (
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
              </svg>
            ))}
          </div>
          <p class="text-text-main/90 italic mb-6">"{review.text}"</p>
          <div class="flex justify-between items-end border-t border-secondary pt-4">
            <span class="font-bold text-primary">{review.name}</span>
            <span class="text-xs text-accent uppercase tracking-wider font-semibold">{review.tag}</span>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
