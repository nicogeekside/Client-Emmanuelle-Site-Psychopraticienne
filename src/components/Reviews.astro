---
import { reviews } from '../data/config';
---

<section class="py-12 bg-secondary/30 rounded-2xl">
  <div class="container mx-auto px-4">
    <h2 class="text-3xl font-serif font-bold text-center text-primary mb-12" data-aos="fade-up">Ce qu'ils disent de l'accompagnement</h2>
    
    <!-- Auto-Scrolling Carousel (Marquee) -->
    <div class="relative overflow-hidden mask-gradient">
      <div class="flex gap-8 w-max animate-scroll">
        <!-- Duplicate reviews for infinite loop -->
        {[...reviews, ...reviews].map((review) => (
          <div class="bg-white p-8 rounded-xl shadow-sm hover:shadow-md transition-all flex-shrink-0 w-[85vw] md:w-[400px] flex flex-col">
            <div class="flex text-accent mb-4">
              {[...Array(review.stars)].map(() => (
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                </svg>
              ))}
            </div>
            <p class="text-text-main/90 italic mb-6 flex-grow whitespace-normal">"{review.text}"</p>
            <div class="flex justify-between items-end border-t border-secondary pt-4 mt-auto">
              <span class="font-bold text-primary">{review.name}</span>
              <span class="text-xs text-accent uppercase tracking-wider font-semibold">{review.tag}</span>
            </div>
          </div>
        ))}
      </div>
    </div>
    
    <!-- Scroll Indicators (Optional but helpful) -->
    <div class="flex justify-center gap-2 mt-4 md:hidden">
         {reviews.map((_, index) => (
            <div class={`w-2 h-2 rounded-full ${index === 0 ? 'bg-primary' : 'bg-primary/20'}`}></div>
         ))}
    </div>
  </div>
</section>

<style>
  .animate-scroll {
    animation: scroll 40s linear infinite;
  }
  
  /* Hover pause removed as requested */

  @keyframes scroll {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }

  .mask-gradient {
    mask-image: linear-gradient(to right, transparent, black 5%, black 95%, transparent);
    -webkit-mask-image: linear-gradient(to right, transparent, black 5%, black 95%, transparent);
  }
</style>
