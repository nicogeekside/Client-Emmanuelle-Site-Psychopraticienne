---
import { reviews } from '../data/config';

// Les avis sont dupliqués pour que la boucle soit continue : la seconde série
// est masquée aux lecteurs d'écran pour ne pas annoncer deux fois les mêmes avis.
const defilement = [
  ...reviews.map((avis) => ({ avis, copie: false })),
  ...reviews.map((avis) => ({ avis, copie: true })),
];
---

<section class="py-12 bg-secondary/30 rounded-2xl" aria-labelledby="titre-avis">
  <div class="container mx-auto px-4">
    <h2 id="titre-avis" class="text-3xl font-serif font-bold text-center text-primary mb-12" data-aos="fade-up">
      Ce qu'on en dit
    </h2>

    <div class="marquee relative overflow-hidden mask-gradient" data-marquee>
      <ul class="flex gap-8 w-max animate-scroll list-none m-0 p-0" data-piste>
        {defilement.map(({ avis, copie }) => (
          <li
            class="bg-white p-8 rounded-xl shadow-sm hover:shadow-md transition-shadow flex-shrink-0 w-[85vw] md:w-[400px] flex flex-col"
            aria-hidden={copie ? 'true' : undefined}
          >
            <div class="flex text-accent-dark mb-4" role="img" aria-label={`${avis.stars} étoiles sur 5`}>
              {[...Array(Number(avis.stars) || 5)].map(() => (
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                </svg>
              ))}
            </div>
            <blockquote class="text-text-main/90 italic mb-6 flex-grow whitespace-normal">
              « {avis.text} »
            </blockquote>
            <div class="flex justify-between items-end gap-4 border-t border-secondary pt-4 mt-auto">
              <span class="font-bold text-primary">{avis.name}</span>
              <span class="text-xs text-accent-dark uppercase tracking-wider font-semibold">{avis.tag}</span>
            </div>
          </li>
        ))}
      </ul>
    </div>

    <div class="flex justify-center mt-6" data-commande-pause>
      <button
        type="button"
        data-pause
        class="inline-flex items-center gap-2 text-sm font-semibold text-primary px-4 py-2 rounded-full border border-primary/30 bg-white/70 hover:bg-white transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 focus-visible:ring-offset-secondary"
        aria-pressed="false"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" data-icone-pause>
          <path d="M6 4h3v12H6zM11 4h3v12h-3z" />
        </svg>
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 hidden" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" data-icone-lecture>
          <path d="M6 4l10 6-10 6z" />
        </svg>
        <span data-libelle>Mettre en pause</span>
      </button>
    </div>
  </div>
</section>

<script>
  const bloc = document.querySelector('[data-marquee]');
  const bouton = document.querySelector('[data-pause]');

  if (bloc && bouton) {
    const libelle = bouton.querySelector('[data-libelle]');
    const iconePause = bouton.querySelector('[data-icone-pause]');
    const iconeLecture = bouton.querySelector('[data-icone-lecture]');
    let enPause = false;

    // Si le système demande moins de mouvement, le défilement ne démarre pas
    // et le bouton n'a plus lieu d'être.
    const moinsDeMouvement = window.matchMedia('(prefers-reduced-motion: reduce)');
    if (moinsDeMouvement.matches) {
      bloc.classList.add('immobile');
      bouton.closest('[data-commande-pause]')?.classList.add('hidden');
    }

    bouton.addEventListener('click', () => {
      enPause = !enPause;
      bloc.classList.toggle('en-pause', enPause);
      bouton.setAttribute('aria-pressed', String(enPause));
      libelle.textContent = enPause ? 'Reprendre le défilement' : 'Mettre en pause';
      iconePause.classList.toggle('hidden', enPause);
      iconeLecture.classList.toggle('hidden', !enPause);
    });
  }
</script>

<style>
  .animate-scroll {
    animation: scroll 40s linear infinite;
  }

  /* On doit pouvoir s'arrêter pour lire un témoignage : au survol, au focus
     clavier, ou par le bouton. */
  .marquee:hover .animate-scroll,
  .marquee:focus-within .animate-scroll,
  .marquee.en-pause .animate-scroll {
    animation-play-state: paused;
  }

  .marquee.immobile .animate-scroll {
    animation: none;
    flex-wrap: wrap;
    width: 100%;
    justify-content: center;
  }

  .marquee.immobile .animate-scroll li[aria-hidden="true"] { display: none; }

  @keyframes scroll {
    0%   { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }

  .mask-gradient {
    mask-image: linear-gradient(to right, transparent, black 5%, black 95%, transparent);
    -webkit-mask-image: linear-gradient(to right, transparent, black 5%, black 95%, transparent);
  }

  @media (prefers-reduced-motion: reduce) {
    .animate-scroll {
      animation: none;
      flex-wrap: wrap;
      width: 100%;
      justify-content: center;
    }
    /* Les copies ne servent qu'à boucler le défilement : sans défilement,
       elles afficheraient chaque avis deux fois. */
    .animate-scroll li[aria-hidden="true"] { display: none; }
    /* Le masquage du bouton est aussi fait en JS, mais il doit tenir sans JS. */
    [data-commande-pause] { display: none; }
  }
</style>
